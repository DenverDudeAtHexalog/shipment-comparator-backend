# Copy to .env and fill in. Never commit .env.
# Added in later stages, e.g.:
# INTOGLO_API_KEY=
PROVIDER_TIMEOUT_SECONDS=10
ENABLE_MOCK_PROVIDERS=true
# MANUAL_QUOTES_FILE=data/manual_quotes.json
# SEARATES_API_KEY=

# Set true to include a vendor that always fails (demo of graceful failure)
ENABLE_OUTAGE_DEMO=false

# Debug only: show vendors that could not serve a request in the API response
SHOW_UNAVAILABLE=false
